# Pipeline settings
SCRIPT_QUALITY_THRESHOLD=40
MAX_GENERATION_RETRIES=30
TITLE_SIMILARITY_THRESHOLD=0.82
HOOK_SIMILARITY_THRESHOLD=0.84
STORY_SIMILARITY_THRESHOLD=0.76
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-AndrewMultilingualNeural
EDGE_TTS_RATE=-8%
YOUTUBE_PRIVACY_STATUS=public

# Optional free stock providers. Local assets are the fallback.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Required only for a real YouTube upload.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
